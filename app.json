{
  "expo": {
    "name": "ScanFacile",
    "slug": "scanfacile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.badrulbinafruz.scanfacile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ScanFacile a besoin d’accéder à vos photos pour importer des documents.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.jpeg",
              "public.png",
              "public.heic"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B5BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.badrulbinafruz.scanfacile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-image",
      "expo-router",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "ScanFacile utilise la caméra pour numériser vos documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScanFacile a besoin d’accéder à vos photos pour importer des documents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E10",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ScanFacile utilise la caméra pour numériser vos documents.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ScanFacile utilise Face ID pour protéger vos documents verrouillés."
        }
      ]
    ],
    "scheme": "scanfacile",
    "owner": "camscanners-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0211ddc-f40b-4649-a27c-02ddb5026065"
      }
    }
  }
}
